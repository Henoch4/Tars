[Unit]
Description=TARS main memecoin satellite observer (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tars
ConditionPathExists=/etc/tars/ENABLE_MEME_SHADOW
WorkingDirectory=/opt/tars
EnvironmentFile=/etc/tars/agent.env
Environment=DRY_RUN=true
Environment=ALLOW_LIVE=false
ExecStart=/opt/tars/venv/bin/python -c "from src.meme_shadow_runner import observe_once; import time; [ (print(observe_once(output='/opt/tars/data/meme_satellite/shadow_observations.jsonl'), flush=True), time.sleep(300)) for _ in iter(int, 1) ]"
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
