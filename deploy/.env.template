# TARS Trading Scheduler — Environment Configuration
# Copy to .env and fill in values. NEVER commit this file.

# ─── OKX API Credentials (required for live trading) ───
# Create at: https://www.okx.com/account/trade/api
# Permissions: Markets:Read, Trade:Read+Trade
# Trusted IPs: Add your VPS static IP
OKX_API_KEY=okx_xxxxxxxxxxxxxxxx
OKX_API_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
OKX_API_PASSPHRASE=YourStrongPassphrase123!

# ─── Trading Mode ───
# true  = dry-run (no real orders, simulated execution)
# false = LIVE trading (real orders, real money)
DRY_RUN=true

# ─── Scheduler Config ───
# Interval between trading cycles in minutes
SCHEDULER_INTERVAL_MINUTES=15

# Assets to trade (comma-separated, no spaces)
# Supported: BTC-USDT-SWAP, ETH-USDT-SWAP, SOL-USDT-SWAP, BNB-USDT-SWAP
SCHEDULER_ASSETS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,BNB-USDT-SWAP

# Agent ID (for audit log / risk gate)
AGENT_ID=tars-scheduler-001

# ─── Logging ───
LOG_LEVEL=INFO

# ─── T3N / On-chain (optional) ───
# T3N API key for TEE contract interaction
# T3N_API_KEY=0x...
# AGENT_KEY=0x...
# USER_KEY=0x...

# ─── Optional: X402 Payment Middleware ───
# FACILITATOR_URL=https://facilitator.okx.com
# FACILITATOR_AUTH_TOKEN=...